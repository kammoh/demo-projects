FAMILY  = kintex7
PART    = xc7k325tffg676-1
BOARD   = stlv7325
# names the outputs (hdmi_demo.bit) and the constraints (hdmi_demo.xdc), not the netlist
PROJECT = hdmi_demo
CHIPDB  = ${KINTEX7_CHIPDB}

# The netlist is generated by LiteX (hdmi_demo.py), not checked in, and LiteX names everything it
# writes after the platform: the module is sitlinv_stlv7325_v2, in build/gateware/, and its
# $readmemh reads sitlinv_stlv7325_v2_mem.init beside it. hdmi-stlv7325.yaml declares the same
# files as `rtl.generator`, so xeda builds exactly this netlist. The XDC is not LiteX's
# (build/gateware/sitlinv_stlv7325_v2.xdc, with Vivado-only properties live): hdmi_demo.xdc is
# the one maintained for openXC7.
TOP_MODULE  = sitlinv_stlv7325_v2
GATEWARE    = build/gateware
TOP_VERILOG = ${GATEWARE}/${TOP_MODULE}.v
ROM_INIT    = ${GATEWARE}/${TOP_MODULE}_mem.init

include ../openXC7.mk

# yosys reads the .init itself ($readmemh), so it is a prerequisite but not a source on its
# command line (ADDITIONAL_SOURCES would hand it to read_verilog)
${PROJECT}.json: ${ROM_INIT}

# `make` does not run LiteX: a shell with only the openXC7 toolchain has no LiteX, and what
# decides that the netlist is stale (the script and the LiteX packages it imports, judged by
# content) is xeda's job. An absent file stops here, naming the command, instead of as yosys's
# "Can not open file ... for $readmemh". A file that exists is never judged, so editing
# hdmi_demo.py does not refuse the build: run the command again to pick it up.
${TOP_VERILOG} ${ROM_INIT}:
	@echo "$@ is generated by LiteX and is not here. From $(CURDIR), run" >&2
	@echo "    python3 hdmi_demo.py --build --no-compile-gateware --output-dir build" >&2
	@echo "(or, from the repository root: xeda run yosys_fpga hdmi-stlv7325/hdmi-stlv7325.yaml)" >&2
	@false
